# Firebase Configuration for Web Public App
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyYourProductionApiKeyHere"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-firebase-project-id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-firebase-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-firebase-project-id.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"

# Optional: Set to 1 only when running against local Firebase emulators
NEXT_PUBLIC_USE_FIREBASE_EMULATORS="0"
