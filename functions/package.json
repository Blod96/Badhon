{
  "name": "badhon-functions",
  "version": "1.0.0",
  "description": "TypeScript Cloud Functions for Badhon (NWU Blood Connect)",
  "main": "dist/index.js",
  "scripts": {
    "lint": "tsc --noEmit",
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions"
  },
  "engines": {
    "node": "20"
  },
  "dependencies": {
    "@badhon/domain": "workspace:*",
    "@badhon/api-contracts": "workspace:*",
    "firebase-admin": "^12.4.0",
    "firebase-functions": "^5.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  },
  "private": true
}
